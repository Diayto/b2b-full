PORT=8000
CORS_ORIGIN=http://localhost:3000

# ИИ-ассистент (страница «Разбор») — ключ только на сервере, не в Vercel frontend
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Instagram OAuth (опционально)
INSTAGRAM_LIVE_OAUTH_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/connectors/instagram/oauth/callback
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_OAUTH_FRONTEND_REDIRECT_BASE=http://localhost:3000
INSTAGRAM_OAUTH_FRONTEND_PATH=/uploads
