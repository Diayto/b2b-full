# Supabase (обязательно для входа и загрузки свода на главный экран)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Бэкенд (Instagram / API; для сессии со сводной таблицей не обязателен)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Режим чтения контент-метрик через API (опционально)
# VITE_CONTENT_METRICS_READ_MODE=api

# Демо на главном экране без файла (или кнопка «Демо-сценарий» на «Данных»)
# VITE_CHRONA_DEMO_PREVIEW=true

# Instagram на Vercel — обязателен URL задеплоенного бэкенда:
# VITE_API_BASE_URL=https://your-api.example.com
